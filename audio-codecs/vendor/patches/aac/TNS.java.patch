+    // This JAAD call convention is the reverse of FFmpeg's decode flag:
+    // false synthesizes the decoded spectrum (AR); true shapes LTP prediction (MA).
     public void process(ICStream ics, float[] spec, SampleFrequency sf, boolean decode) {
-        // TODO...
+        ICSInfo info = ics.getInfo();
+        int maxBand = Math.min(info.getSWBCount(),
+                Math.min(info.getMaxSFB(), sf.getMaximalTNS_SFB(info.isEightShortFrame())));
+        if (maxBand == 0) return;
+        int[] offsets = info.getSWBOffsets();
+        float[] lpc = new float[TNS_MAX_ORDER];
+        float[] history = new float[TNS_MAX_ORDER + 1];
+        for (int w = 0; w < info.getWindowCount(); w++) {
+            int bottom = info.getSWBCount();
+            for (int f = 0; f < nFilt[w]; f++) {
+                // Filter lengths descend from num_swb, even for zero-order filters.
+                int top = bottom;
+                bottom = Math.max(0, top - length[w][f]);
+                int sizeOrder = order[w][f];
+                if (sizeOrder == 0) continue;
+                int start = offsets[Math.min(bottom, maxBand)];
+                int end = offsets[Math.min(top, maxBand)];
+                int size = end - start;
+                if (size <= 0) continue;
+                // Reflection coefficients are negated by the unnormalized LPC recursion.
+                for (int i = 0; i < sizeOrder; i++) {
+                    float r = -coef[w][f][i];
+                    lpc[i] = r;
+                    for (int j = 0; j < (i + 1) / 2; j++) {
+                        float a = lpc[j], b = lpc[i - 1 - j];
+                        lpc[j] = a + r * b;
+                        lpc[i - 1 - j] = b + r * a;
+                    }
+                }
+                int increment = direction[w][f] ? -1 : 1;
+                start = (direction[w][f] ? end - 1 : start) + w * 128;
+                for (int m = 0; m < size; m++, start += increment) {
+                    if (!decode) {
+                        for (int i = 1; i <= Math.min(m, sizeOrder); i++)
+                            spec[start] -= spec[start - i * increment] * lpc[i - 1];
+                    } else {
+                        history[0] = spec[start];
+                        for (int i = 1; i <= Math.min(m, sizeOrder); i++)
+                            spec[start] += history[i] * lpc[i - 1];
+                        for (int i = sizeOrder; i > 0; i--) history[i] = history[i - 1];
+                    }
+                    if (!Float.isFinite(spec[start]))
+                        throw new IllegalArgumentException("Non-finite TNS spectrum");
+                }
+            }
+        }
